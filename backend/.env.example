# Every variable the API reads. Nothing else here is consulted anywhere in
# backend/src — the seven POSTGRES_* entries this file used to list were never
# read by anything, because the API talks to Supabase's REST endpoint rather
# than opening its own database connection.

# Supabase. The service role key bypasses row level security, which is what lets
# the API do its own tenant filtering. It must never reach the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Signing key for the tokens this API issues. These are the app's own tokens,
# not Supabase's, so this is not any Supabase key.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3001

# Where the browser app runs. Used for the CORS allow-list.
FRONTEND_URL=http://localhost:3000
